# Copy to .env and fill in real values. .env is gitignored.

APP_ENV=development
PORT=8080

# Neon Postgres connection string (keep sslmode=require for Neon).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Caps the pgxpool size — see internal/database.NewPool. Defaults to 5 if
# unset; keep it well under whatever connection limit your Postgres plan
# allows (Neon's free tier is limited, and this matters more the more
# instances/deploys you might have running at once).
DB_MAX_CONNS=5

# Required. Checked against the X-Internal-Token header on POST
# /internal/scrape. Generate one with e.g. `openssl rand -hex 32`.
INTERNAL_TOKEN=change-me

# Local Postgres used by internal/store's tests (go test skips them if
# this isn't set) and by `make test-db-setup`. Needs CREATE privilege on
# the database (tests create/drop their own scratch schemas per run).
TEST_DATABASE_URL=postgres://user:password@localhost:5432/loker_test_db?sslmode=disable
